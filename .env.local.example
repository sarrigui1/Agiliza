NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo para Route Handlers/Cron en el servidor (Fase 3) — NUNCA exponer con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=your-cron-secret

# Notificaciones WhatsApp (Twilio) — opcional, solo si se activa el switch maestro en
# /admin/notificaciones. Sin estas variables, el sistema funciona igual pero no envía nada.
# Para probar con una cuenta Trial de Twilio, usa el número de Sandbox de WhatsApp
# (Twilio Console -> Messaging -> Try it out -> Send a WhatsApp message), normalmente
# +14155238886 — cada número de prueba debe "unirse" mandándole "join <código>" antes.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Opcional: dominio público del despliegue, usado para que Twilio pueda llamar de vuelta
# a /api/webhooks/twilio/status con el estado de entrega. En Vercel se resuelve solo con
# VERCEL_URL si esta variable no está seteada.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Monitoreo de errores (Sentry) — opcional. Sin esto, el sistema funciona igual pero nadie
# se entera de un error en producción hasta que un cliente llama molesto.
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXXXX.ingest.us.sentry.io/XXXXXX
